# Comma-separated wallets to watch. When one of these mints, you mint too.
WATCH_ADDRESSES=0x0000000000000000000000000000000000000000

# Your minter private keys. Each one sends the same mint.
MINTER_PRIVATE_KEYS=0xYOUR_KEY

# Optional. If your minters are empty, this wallet bridges or swaps into them.
# Leave blank to only use funds already on each minter.
FUNDER_PRIVATE_KEY=

# Chains to watch and to pull funds from. Comma-separated chain ids.
# 1 ETH, 10 Optimism, 56 BSC, 137 Polygon, 8453 Base, 42161 Arbitrum,
# 999 HyperEVM, 4663 Robinhood
CHAINS=1,10,56,137,8453,42161,999,4663

# Optional dedicated RPCs. Public defaults are used when a line is missing.
# Production should set these. Public RPCs rate-limit.
# RPC_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_4663=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_8453=
# RPC_42161=
# RPC_10=
# RPC_56=
# RPC_137=
# RPC_999=

# Optional WebSocket endpoints for near-instant detection. Must start with wss://
# Polling stays on as a slow backup while a socket is live, and runs at full speed if it drops.
# WSS_1=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WSS_8453=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# While a socket is live, the bot only checks the latest block number this often (one cheap request).
# If the socket drops or reconnects, it scans the missed blocks once.
# WSS_BACKUP_SECONDS=30
# WSS_BACKUP_SCAN=false
# Blocks per eth_getLogs request. Alchemy's free plan allows at most 10.
# LOGS_MAX_BLOCKS=10

# Do not copy a mint that costs more than this much native coin.
# The unit is each chain's own coin (ETH, BNB, POL). Override one chain with MAX_MINT_<chainId>.
MAX_MINT_ETH=0.05
# MAX_MINT_56=0.1
# MAX_MINT_137=50

# Optional. After one mint of a collection is copied, ignore repeat mints of the same
# collection on the same chain for this many seconds. 0 (the default) turns it off.
# Leave it off if a watched wallet mints several times in a row.
MINT_COOLDOWN_SECONDS=0

# Optional Telegram alerts. Leave blank to log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public RPCs often cannot simulate. By default the bot skips a mint it cannot simulate.
# Set true to send on a gas estimate alone, which does not prove you receive the NFT.
ALLOW_ESTIMATE_FALLBACK=false

# Bridge or swap from other chains when the mint chain is short.
ENABLE_BRIDGE=true
BRIDGE_TIMEOUT=180

# How often to look for new blocks, in seconds.
POLL_SECONDS=0.4

# Survives restarts if you mount a Railway volume at /data.
STATE_PATH=/data/state.json

# OpenSea purchases (/buy and /sweep). MAX_BUY_ETH is the most one purchase may cost.
OPENSEA_API_KEY=
MAX_BUY_ETH=0.05
SWEEP_POLL_SECONDS=5
# Optional: wrapped-coin address for offers on a chain the bot does not know (WETH_<chain id>).
# WETH_4663=
# Optional: override OpenSea's live feed address.
# OPENSEA_STREAM_URL=

# Log the mint it would send, but do not broadcast or bridge.
# On Railway set this to true, redeploy, then set false or delete it to go live.
DRY_RUN=false
